class Product(Base):

    __tablename__ = "products"

    id = Column(
        Integer,
        primary_key=True,
        index=True
    )

    product_id = Column(
        String,
        unique=True,
        nullable=False,
        index=True
    )

    rfid_tag = Column(
        String,
        unique=True,
        nullable=False,
        index=True
    )

    product_name = Column(
        String,
        nullable=False
    )

    category = Column(
        String,
        nullable=False
    )

    quantity = Column(
        Integer,
        default=0
    )

    reorder_level = Column(
        Integer,
        default=10
    )

    location = Column(
        String,
        default="A1"
    )

    last_movement = Column(
        DateTime,
        nullable=True
    )


class RFIDEvent(Base):

    __tablename__ = "rfid_events"

    id = Column(
        Integer,
        primary_key=True,
        index=True
    )

    timestamp = Column(
        DateTime,
        default=datetime.utcnow
    )

    rfid_tag = Column(
        String,
        nullable=False,
        index=True
    )

    product_id = Column(
        String,
        nullable=False
    )

    action = Column(
        String,
        nullable=False
    )

    location = Column(
        String,
        nullable=False
    )

    quantity = Column(
        Integer,
        nullable=False
    )

    quantity_after = Column(
        Integer,
        nullable=False
    )


