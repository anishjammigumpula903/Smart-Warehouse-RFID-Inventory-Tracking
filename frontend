{rfid:'RFID-0026',name:'Adjustable Wrench',category:'Tools',qty:40,reorder:15,location:'B1'},
{rfid:'RFID-0027',name:'Tool Kit Box',category:'Tools',qty:18,reorder:6,location:'B1'},
{rfid:'RFID-0028',name:'Printer Cartridge',category:'Office',qty:60,reorder:20,location:'C1'},
{rfid:'RFID-0029',name:'A4 Paper Pack',category:'Office',qty:300,reorder:100,location:'C1'},
{rfid:'RFID-0030',name:'Stapler',category:'Office',qty:80,reorder:30,location:'C1'},

{rfid:'RFID-0031',name:'Notebook Pack',category:'Office',qty:120,reorder:40,location:'C1'},
{rfid:'RFID-0032',name:'Marker Pens',category:'Office',qty:140,reorder:50,location:'C1'},
{rfid:'RFID-0033',name:'Whiteboard',category:'Office',qty:10,reorder:4,location:'C2'},
{rfid:'RFID-0034',name:'Projector',category:'Electronics',qty:6,reorder:2,location:'C2'},
{rfid:'RFID-0035',name:'Laptop Charger',category:'Electronics',qty:35,reorder:10,location:'C2'},
{rfid:'RFID-0036',name:'Tablet Device',category:'Electronics',qty:22,reorder:8,location:'C2'},
{rfid:'RFID-0037',name:'LED Strip Light',category:'Electronics',qty:70,reorder:20,location:'C2'},
{rfid:'RFID-0038',name:'Server Rack',category:'IT',qty:8,reorder:3,location:'D3'},
{rfid:'RFID-0039',name:'Network Switch',category:'IT',qty:12,reorder:4,location:'D3'},
{rfid:'RFID-0040',name:'UPS Battery',category:'IT',qty:18,reorder:6,location:'D3'},

{rfid:'RFID-0041',name:'SSD Drive',category:'IT',qty:50,reorder:15,location:'D3'},
{rfid:'RFID-0042',name:'RAM Module',category:'IT',qty:65,reorder:20,location:'D3'},
{rfid:'RFID-0043',name:'Cooling Fan',category:'Electronics',qty:90,reorder:30,location:'D3'},
{rfid:'RFID-0044',name:'Graphics Card',category:'Electronics',qty:7,reorder:3,location:'D3'},
{rfid:'RFID-0045',name:'Motherboard',category:'Electronics',qty:11,reorder:4,location:'D3'},
{rfid:'RFID-0046',name:'CPU Processor',category:'Electronics',qty:9,reorder:3,location:'D3'},
{rfid:'RFID-0047',name:'Keyboard Tray',category:'Furniture',qty:40,reorder:15,location:'D4'},
{rfid:'RFID-0048',name:'Monitor Stand',category:'Furniture',qty:28,reorder:10,location:'D4'},
{rfid:'RFID-0049',name:'Cable Organizer',category:'Accessories',qty:150,reorder:40,location:'B2'},
{rfid:'RFID-0050',name:'Desk Drawer Unit',category:'Furniture',qty:16,reorder:6,location:'D4'}
];

let inventory = JSON.parse(JSON.stringify(PRODUCTS));
let movements = [];
let scanCount = 0;
let selectedAction = 'IN';
let autoInterval = null;

// ──────────────────────────────────────────────
//  INIT
// ──────────────────────────────────────────────
function init() {
  populateRFIDDropdown();
  renderInventory();
  renderKPIs();
  renderAlerts();
}

function populateRFIDDropdown() {
  const sel = document.getElementById('rfidSelect');
  sel.innerHTML = '';
  inventory.forEach(p => {
    const opt = document.createElement('option');
    opt.value = p.rfid;
    opt.textContent = `${p.rfid} — ${p.name}`;
    sel.appendChild(opt);
  });
}

// ──────────────────────────────────────────────
//  SCAN LOGIC
// ──────────────────────────────────────────────
function setAction(a) {
  selectedAction = a;
  document.getElementById('btnIN').className  = 'toggle-btn' + (a === 'IN'  ? ' active-in'  : '');
  document.getElementById('btnOUT').className = 'toggle-btn' + (a === 'OUT' ? ' active-out' : '');
}

function performScan(autoData) {
  const rfidId  = autoData ? autoData.rfid     : document.getElementById('rfidSelect').value;
  const loc     = autoData ? autoData.loc      : document.getElementById('locationSelect').value;
  const action  = autoData ? autoData.action   : selectedAction;
  const qty     = autoData ? autoData.qty      : parseInt(document.getElementById('qtyInput').value) || 1;

  const product = inventory.find(p => p.rfid === rfidId);
  if (!product) return;

  let changed = 0;
  if (action === 'IN') {
    product.qty += qty;
    changed = qty;
  } else {
    if (product.qty <= 0) {
      showToast(`${product.name} — OUT OF STOCK`, 'warn');
      return;
    }
    changed = Math.min(qty, product.qty);
    product.qty -= changed;
  }

  product.lastMov = action;
  product.lastMovTime = new Date();
  product.location = loc;
  if (action === 'OUT') recordDemand(rfidId, changed);

  scanCount++;

  // Movement log entry
  const log = {
    time: new Date(),
    rfid: rfidId,
    product: product.name,
    action,
    location: loc,
    qty: product.qty,
    changed
  };
  movements.unshift(log);
  if (movements.length > 200) movements.pop();

  // Animate chip
  const chip = document.getElementById('rfidChip');
  chip.classList.add('scanning');
  document.getElementById('chipId').textContent = rfidId;
  setTimeout(() => chip.classList.remove('scanning'), 600);

  // Animate scan button
  const btn = document.getElementById('scanBtn');
  btn.classList.add('scanning-anim');
  setTimeout(() => btn.classList.remove('scanning-anim'), 600);

  // Update last scan box
  document.getElementById('lastScanBox').innerHTML = `
    <div class="scan-result">
      ${action === 'IN' ? '▲' : '▼'} ${action} ${changed} × ${product.name}<br/>
      TAG: ${rfidId}<br/>
      LOC: ${loc} &nbsp;|&nbsp; STOCK NOW: ${product.qty} units
    </div>`;

  // Toast
  const toastType = action === 'IN' ? 'in-toast' : 'out-toast';
  showToast(`${action} ${changed}× ${product.name} @ ${loc}`, toastType);

  // Low stock alert toast
  if (product.qty <= product.reorder) {
    setTimeout(() => {
      showToast(`⚠ LOW STOCK: ${product.name} (${product.qty} left)`, 'warn-toast');
    }, 800);
  }

  renderInventory(rfidId);
  renderMovements();
  renderKPIs();
  renderAlerts();
}

// ──────────────────────────────────────────────
//  RENDER INVENTORY
// ──────────────────────────────────────────────
function renderInventory(highlightRfid) {
  const tbody = document.getElementById('inventoryBody');
  document.getElementById('inventoryCount').textContent = `${inventory.length} products`;

  tbody.innerHTML = inventory.map(p => {
    const maxQty = PRODUCTS.find(x => x.rfid === p.rfid)?.qty || 100;
    const pct = Math.min(100, Math.round((p.qty / (maxQty * 1.5)) * 100));
    const ratio = p.qty / p.reorder;
    const status = p.qty === 0 ? 'critical' : ratio <= 1 ? 'critical' : ratio <= 1.5 ? 'low' : 'ok';
    const statusLabel = p.qty === 0 ? 'OUT OF STOCK' : status === 'critical' ? 'CRITICAL' : status === 'low' ? 'LOW STOCK' : 'IN STOCK';
    const barColor = status === 'ok' ? 'var(--accent3)' : status === 'low' ? 'var(--warn)' : 'var(--danger)';
    const qtyColor = status === 'ok' ? 'var(--text)' : status === 'low' ? 'var(--warn)' : 'var(--danger)';
    const lastMov = p.lastMovTime
      ? `<span style="color:${p.lastMov==='IN'?'var(--accent3)':'var(--accent2)'}">
           ${p.lastMov} — ${timeAgo(p.lastMovTime)}
         </span>`
      : `<span style="color:var(--muted)">—</span>`;

    const flash = highlightRfid === p.rfid ? ' class="flash-row"' : '';

    return `<tr${flash}>
      <td><span class="rfid-badge">${p.rfid}</span></td>
      <td style="font-weight:500">${p.name}</td>
      <td style="color:var(--muted);font-size:12px">${p.category}</td>
      <td><span class="loc-badge">${p.location}</span></td>
      <td><span class="qty-cell" style="color:${qtyColor}">${p.qty}</span></td>
      <td>
        <div class="stock-bar-wrap">
          <div class="stock-bar" style="width:${pct}%;background:${barColor}"></div>
        </div>
      </td>
      <td style="font-family:var(--mono);font-size:11px;color:var(--muted)">${p.reorder}</td>
      <td><span class="status-badge status-${status}">${statusLabel}</span></td>
      <td style="font-size:11px">${lastMov}</td>
    </tr>`;
  }).join('');
}

