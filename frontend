// ══════════════════════════════════════════════════════════════════
//  ML ENGINE — Linear Regression + Exponential Smoothing + Reorder
// ══════════════════════════════════════════════════════════════════

// Seed synthetic history for each product at startup
// Each product gets 30 days of simulated OUT movements (demand)
const demandHistory = {}; // { rfid: [{ day: -N, qty: X }, ...] }

function seedHistory() {
  PRODUCTS.forEach(p => {
    const base = Math.max(1, Math.round(p.reorder * 0.6));
    const days = [];
    for (let d = 29; d >= 0; d--) {
      // add trend + noise + occasional spike
      const trend  = d < 15 ? 0 : (p.qty > 50 ? 0.3 : -0.2);      // recent slight uptick
      const noise  = (Math.random() - 0.5) * base * 0.8;
      const spike  = Math.random() < 0.08 ? base * 1.8 : 0;        // 8% chance spike
      const raw    = base + trend * (30 - d) + noise + spike;
      days.push({ day: -d, qty: Math.max(0, Math.round(raw)) });
    }
    demandHistory[p.rfid] = days;
  });
}

// When a real OUT scan happens, append to demandHistory
function recordDemand(rfidId, qty) {
  if (!demandHistory[rfidId]) demandHistory[rfidId] = [];
  demandHistory[rfidId].push({ day: 0, qty });
  if (demandHistory[rfidId].length > 60) demandHistory[rfidId].shift();
}

// ── Linear Regression on last N days ─────────────────────────────
function linearRegression(data) {
  const n = data.length;
  if (n < 2) return { slope: 0, intercept: data[0]?.qty || 0, r2: 0 };
  let sumX=0, sumY=0, sumXY=0, sumX2=0;
  data.forEach((d,i) => { sumX+=i; sumY+=d.qty; sumXY+=i*d.qty; sumX2+=i*i; });
  const slope     = (n*sumXY - sumX*sumY) / (n*sumX2 - sumX*sumX);
  const intercept = (sumY - slope*sumX) / n;
  // R²
  const yMean = sumY / n;
  let ssTot=0, ssRes=0;
  data.forEach((d,i) => { ssTot+=(d.qty-yMean)**2; ssRes+=(d.qty-(slope*i+intercept))**2; });
  const r2 = ssTot === 0 ? 1 : Math.max(0, 1 - ssRes/ssTot);
  return { slope, intercept, r2 };
}

// ── Exponential Smoothing (alpha=0.3) ────────────────────────────
function expSmoothing(data, alpha=0.3) {
  if (!data.length) return 0;
  let s = data[0].qty;
  for (let i=1;i<data.length;i++) s = alpha*data[i].qty + (1-alpha)*s;
  return s;
}

// ── Moving Average ────────────────────────────────────────────────
function movingAvg(data, window=7) {
  const slice = data.slice(-window);
  return slice.reduce((a,b)=>a+b.qty,0) / slice.length;
}

// ── Ensemble forecast: blend LR + ES + MA ────────────────────────
function forecastDemand(rfidId, horizonDays=7) {
  const hist = demandHistory[rfidId] || [];
  if (hist.length < 3) return { daily: 1, total: horizonDays, confidence: 0.3, trend: 'flat' };

  const lr   = linearRegression(hist);
  const es   = expSmoothing(hist);
  const ma   = movingAvg(hist);
  const lrNext = Math.max(0, lr.intercept + lr.slope * hist.length);

  // weighted ensemble
  const daily = Math.max(0, 0.4*lrNext + 0.35*es + 0.25*ma);
  const total = Math.round(daily * horizonDays);

  // confidence based on R² and data volume
  const confidence = Math.min(0.97, 0.4 + lr.r2*0.4 + Math.min(hist.length/30,1)*0.2);

  // trend direction
  const trend = lr.slope > 0.15 ? 'up' : lr.slope < -0.15 ? 'down' : 'flat';

  return { daily: Math.round(daily*10)/10, total, confidence: Math.round(confidence*100), trend, lr, es, ma };
}

// ── Reorder recommendation ────────────────────────────────────────
function getRecommendation(product, forecast) {
  const p = product;
  const daysOfStock = forecast.daily > 0 ? Math.floor(p.qty / forecast.daily) : 99;
  const leadTimeDays = 3; // assumed lead time
  const safetyStock  = Math.ceil(forecast.daily * leadTimeDays * 1.5);
  const reorderQty   = Math.max(p.reorder, Math.ceil(forecast.total * 2));

  let level, label, color;
  if (p.qty === 0)              { level='urgent';  label='REORDER NOW — OUT OF STOCK'; }
  else if (daysOfStock <= leadTimeDays) { level='urgent';  label=`REORDER NOW — ${daysOfStock}d left`; }
  else if (p.qty <= p.reorder)  { level='reorder'; label=`REORDER SOON — ${daysOfStock}d left`; }
  else if (daysOfStock <= 14)   { level='watch';   label=`MONITOR — ${daysOfStock}d left`; }
  else                          { level='ok';      label=`SUFFICIENT — ${daysOfStock}d left`; }

  return { level, label, daysOfStock, safetyStock, reorderQty };
}

