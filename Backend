# ============================================================
# SECTION 6 — RFID SERVICE
# Original: backend/services/rfid_service.py
# ============================================================


VALID_LOCATIONS = {

    "A1": "Receiving Bay",

    "B2": "Storage East",

    "C3": "Storage West",

    "D4": "Dispatch Bay",

    "E5": "Cold Storage",

}


def process_rfid_scan(
    db: Session,
    rfid_tag: str,
    location: str,
    action: str,
    quantity: int,
):
    """
    Process an RFID scan.

    Steps:
    1. Validate warehouse location.
    2. Find product using RFID tag.
    3. Validate IN/OUT operation.
    4. Update inventory.
    5. Record RFID event.
    6. Commit transaction.
    """

    # --------------------------------------------------------
    # Validate warehouse location
    # --------------------------------------------------------

    if location not in VALID_LOCATIONS:

        raise ValueError(
            f"Invalid warehouse location: {location}"
        )


    # --------------------------------------------------------
    # Find product
    # --------------------------------------------------------

    product = (
        db.query(Product)
        .filter(
            Product.rfid_tag == rfid_tag
        )
        .first()
    )


    if product is None:

        raise ValueError(
            f"RFID tag not found: {rfid_tag}"
        )


    # --------------------------------------------------------
    # Get current inventory
    # --------------------------------------------------------

    current_quantity = product.quantity


    # --------------------------------------------------------
    # Process IN transaction
    # --------------------------------------------------------

    if action == "IN":

        new_quantity = (
            current_quantity + quantity
        )


    # --------------------------------------------------------
    # Process OUT transaction
    # --------------------------------------------------------

    elif action == "OUT":

        if quantity > current_quantity:

            raise ValueError(
                "Insufficient inventory "
                "for OUT transaction"
            )

        new_quantity = (
            current_quantity - quantity
        )


    # --------------------------------------------------------
    # Invalid action
    # --------------------------------------------------------

    else:

        raise ValueError(
            "Action must be IN or OUT"
        )


    # --------------------------------------------------------
    # Timestamp
    # --------------------------------------------------------

    now = datetime.utcnow()


    # --------------------------------------------------------
    # Update product
    # --------------------------------------------------------

    product.quantity = new_quantity

    product.location = location

    product.last_movement = now


    # --------------------------------------------------------
    # Create RFID event
    # --------------------------------------------------------

    event = RFIDEvent(

        timestamp=now,

        rfid_tag=rfid_tag,

        product_id=product.product_id,

        action=action,

        location=location,

        quantity=quantity,

        quantity_after=new_quantity,

    )


    # --------------------------------------------------------
    # Save event
    # --------------------------------------------------------

    db.add(event)

    db.commit()

    db.refresh(event)


    return product, event


