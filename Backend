@inventory_router.get(
    "/{rfid_tag}"
)
def get_inventory_product(

    rfid_tag: str,

    db: Session = Depends(get_db)

):

    product = (
        get_product_by_rfid(

            db,

            rfid_tag

        )
    )


    if product is None:

        raise HTTPException(

            status_code=404,

            detail=
                "RFID tag not found"

        )


    return {

        "product_id":
            product.product_id,

        "rfid_tag":
            product.rfid_tag,

        "product_name":
            product.product_name,

        "category":
            product.category,

        "quantity":
            product.quantity,

        "reorder_level":
            product.reorder_level,

        "location":
            product.location,

        "stock_status":
            get_stock_status(product),

        "last_movement":
            product.last_movement,

    }


