// ── Sparkline chart for single product (SVG) ─────────────────────
function buildSingleChart(p, fc, hist) {
  const pts = hist.slice(-14);
  if (pts.length < 2) return '';
  const W=600, H=80, pad=10;
  const maxY = Math.max(...pts.map(d=>d.qty), fc.daily*1.4) || 1;
  const xStep = (W-pad*2)/(pts.length-1);
  const yScale = (H-pad*2)/maxY;
  const toX = i => pad + i*xStep;
  const toY = v => H-pad - v*yScale;
  const polyline = pts.map((d,i)=>`${toX(i).toFixed(1)},${toY(d.qty).toFixed(1)}`).join(' ');
  const areaPath = `M${toX(0).toFixed(1)},${H-pad} ` + pts.map((d,i)=>`L${toX(i).toFixed(1)},${toY(d.qty).toFixed(1)}`).join(' ') + ` L${toX(pts.length-1).toFixed(1)},${H-pad} Z`;
  const forecastY = toY(fc.daily).toFixed(1);

  return `<div class="ai-chart-wrap">
    <div class="ai-chart-title">${p.name} — 14-DAY DEMAND HISTORY + FORECAST LINE</div>
    <svg class="ai-chart-svg" viewBox="0 0 ${W} ${H}" style="height:90px;">
      <defs>
        <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#a78bfa" stop-opacity="0.25"/>
          <stop offset="100%" stop-color="#a78bfa" stop-opacity="0.02"/>
        </linearGradient>
      </defs>
      <path d="${areaPath}" fill="url(#areaGrad)"/>
      <polyline points="${polyline}" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linejoin="round"/>
      ${pts.map((d,i)=>`<circle cx="${toX(i).toFixed(1)}" cy="${toY(d.qty).toFixed(1)}" r="3" fill="#a78bfa"/>`).join('')}
      <line x1="${pad}" y1="${forecastY}" x2="${W-pad}" y2="${forecastY}" stroke="#00e5ff" stroke-width="1.5" stroke-dasharray="5,4"/>
      <text x="${W-pad+4}" y="${parseFloat(forecastY)+4}" font-family="monospace" font-size="9" fill="#00e5ff">FCST</text>
    </svg>
  </div>`;
}

// ── Bar chart for all-products view (top 12 by demand) ───────────
function buildForecastChart(results) {
  const top = results.slice(0,12);
  const W=700, H=90, pad=10, barW=42, gap=8;
  const maxVal = Math.max(...top.map(r=>r.fc.total)) || 1;
  const toH = v => Math.round((v/maxVal)*(H-pad*2-14));
  const colorOf = lvl => lvl==='urgent'?'#ff3b5c':lvl==='reorder'?'#ffb700':lvl==='watch'?'#00e5ff':'#39ff6e';

  const bars = top.map((r,i) => {
    const bh = toH(r.fc.total);
    const bx = pad + i*(barW+gap);
    const by = H-pad-14-bh;
    const abbr = r.p.name.split(' ').map(w=>w[0]).join('').slice(0,3).toUpperCase();
    return `
      <rect x="${bx}" y="${by}" width="${barW}" height="${bh}" rx="3" fill="${colorOf(r.rec.level)}" opacity="0.8"/>
      <text x="${bx+barW/2}" y="${H-pad-1}" text-anchor="middle" font-family="monospace" font-size="8" fill="#5a7a8a">${abbr}</text>
      <text x="${bx+barW/2}" y="${by-3}" text-anchor="middle" font-family="monospace" font-size="8" fill="#e8edf2">${r.fc.total}</text>`;
  }).join('');

  return `<div class="ai-chart-wrap">
    <div class="ai-chart-title">7-DAY DEMAND FORECAST BY PRODUCT (TOP 12) &nbsp;·&nbsp;
      <span style="color:#ff3b5c">■ URGENT</span> &nbsp;
      <span style="color:#ffb700">■ REORDER</span> &nbsp;
      <span style="color:#00e5ff">■ WATCH</span> &nbsp;
      <span style="color:#39ff6e">■ OK</span>
    </div>
    <svg class="ai-chart-svg" viewBox="0 0 ${W} ${H}" style="height:100px;">
      ${bars}
    </svg>
  </div>`;
}

