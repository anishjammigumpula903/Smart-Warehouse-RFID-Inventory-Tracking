def get_all_products(
    db: Session
):

    return (

        db.query(Product)

        .order_by(
            Product.product_id
        )

        .all()

    )


def get_product_by_rfid(
    db: Session,
    rfid_tag: str
):

    return (

        db.query(Product)

        .filter(
            Product.rfid_tag == rfid_tag
        )

        .first()

    )


def get_stock_status(
    product: Product
) -> str:

    # --------------------------------------------------------
    # No stock
    # --------------------------------------------------------

    if product.quantity == 0:

        return "URGENT"


    # --------------------------------------------------------
    # At or below reorder level
    # --------------------------------------------------------

    if (
        product.quantity
        <= product.reorder_level
    ):

        return "REORDER"


    # --------------------------------------------------------
    # Approaching reorder level
    # --------------------------------------------------------

    if (
        product.quantity
        <= product.reorder_level * 2
    ):

        return "WATCH"


    # --------------------------------------------------------
    # Healthy inventory
    # --------------------------------------------------------

    return "OK"


def get_inventory_with_status(
    db: Session
):

    products = get_all_products(db)

    result = []


    for product in products:

        result.append({

            "product_id":
                product.product_id,

            "rfid_tag":
                product.rfid_tag,

            "product_name":
                product.product_name,

            "category":
                product.category,

            "quantity":
                product.quantity,

            "reorder_level":
                product.reorder_level,

            "location":
                product.location,

            "stock_status":
                get_stock_status(product),

            "last_movement":
                product.last_movement,

        })


    return result


# ============================================================
# SECTION 8 — ALERT SERVICE
# Original: backend/services/alert_service.py
# ============================================================


def get_inventory_alerts(
    db: Session
):

    inventory = (
        get_inventory_with_status(db)
    )


    alerts = [

        product

        for product in inventory

        if product["stock_status"]
        in {
            "URGENT",
            "REORDER"
        }

    ]


    return alerts


