# SECTION 11 — ANALYTICS API ROUTES
# Original: backend/api/routes_analytics.py
# ============================================================


analytics_router = APIRouter(

    prefix="/analytics",

    tags=[
        "Analytics"
    ]

)


@analytics_router.get(
    "/kpis"
)
def get_kpis(

    db: Session = Depends(get_db)

):

    products = (

        db.query(Product)

        .all()

    )


    events = (

        db.query(RFIDEvent)

        .all()

    )


    # --------------------------------------------------------
    # Total SKUs
    # --------------------------------------------------------

    total_skus = len(
        products
    )


    # --------------------------------------------------------
    # Total stock
    # --------------------------------------------------------

    total_stock = sum(

        product.quantity

        for product in products

    )


    # --------------------------------------------------------
    # Active alerts
    # --------------------------------------------------------

    active_alerts = sum(

        1

        for product in products

        if (
            product.quantity
            <= product.reorder_level
        )

    )


    # --------------------------------------------------------
    # RFID scan events
    # --------------------------------------------------------

    scan_events = len(
        events
    )


    return {

        "total_skus":
            total_skus,

        "total_stock":
            total_stock,

        "active_alerts":
            active_alerts,

        "scan_events":
            scan_events,

    }


@analytics_router.get(
    "/movements"
)
def get_movement_statistics(

    db: Session = Depends(get_db)

):

    events = (

        db.query(RFIDEvent)

        .all()

    )


    total_events = len(
        events
    )


    in_events = sum(

        1

        for event in events

        if event.action == "IN"

    )


    out_events = sum(

        1

        for event in events

        if event.action == "OUT"

    )


    return {

        "total_events":
            total_events,

        "in_events":
            in_events,

        "out_events":
            out_events,

    }


