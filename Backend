# SECTION 9 — RFID API ROUTES
# Original: backend/api/routes_rfid.py
# ============================================================


rfid_router = APIRouter(

    prefix="/rfid",

    tags=[
        "RFID"
    ]

)


@rfid_router.post(

    "/scan",

    response_model=RFIDScanResponse

)
def scan_rfid(

    request: RFIDScanRequest,

    db: Session = Depends(get_db)

):

    try:

        product, event = (
            process_rfid_scan(

                db=db,

                rfid_tag=
                    request.rfid_tag,

                location=
                    request.location,

                action=
                    request.action,

                quantity=
                    request.quantity,

            )
        )


        return {

            "success":
                True,

            "rfid_tag":
                product.rfid_tag,

            "product_id":
                product.product_id,

            "product_name":
                product.product_name,

            "action":
                event.action,

            "location":
                event.location,

            "quantity":
                event.quantity,

            "quantity_after":
                event.quantity_after,

            "timestamp":
                event.timestamp,

        }


    except ValueError as error:

        raise HTTPException(

            status_code=400,

            detail=str(error)

        )


@rfid_router.get(
    "/events"
)
def get_rfid_events(

    db: Session = Depends(get_db)

):

    events = (

        db.query(RFIDEvent)

        .order_by(

            RFIDEvent.timestamp.desc()

        )

        .all()

    )


    return events


