from fastapi import FastAPI

from backend.database.database import Base, engine

# Import models so SQLAlchemy registers the tables before
# create_all() is executed.
from backend.database import models

from backend.api.routes_rfid import router as rfid_router
from backend.api.routes_inventory import router as inventory_router
from backend.api.routes_analytics import router as analytics_router


Base.metadata.create_all(bind=engine)


app = FastAPI(
    title="Smart Warehouse RFID API",
    description=(
        "Backend API for RFID-based warehouse "
        "inventory tracking, analytics and AI."
    ),
    version="1.0.0",
)


app.include_router(rfid_router)
app.include_router(inventory_router)
app.include_router(analytics_router)


@app.get("/")
def root():
    return {
        "application": "Smart Warehouse RFID Inventory Tracking",
        "version": "1.0.0",
        "status": "online",
    }


@app.get("/health")
def health_check():
    return {
        "status": "healthy"
    }
