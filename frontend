<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>SmartWare — RFID Inventory System</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #080c10;
    --surface: #0d1117;
    --panel: #111820;
    --border: #1e2d3d;
    --accent: #00e5ff;
    --accent2: #ff6b35;
    --accent3: #39ff6e;
    --warn: #ffb700;
    --danger: #ff3b5c;
    --text: #e8edf2;
    --muted: #5a7a8a;
    --mono: 'Space Mono', monospace;
    --sans: 'DM Sans', sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Grid background */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,229,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,229,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  /* ──── HEADER ──── */
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(8,12,16,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding: 0 32px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-family: var(--mono);
    font-size: 18px;
    color: var(--accent);
    letter-spacing: 2px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .logo-dot { width: 8px; height: 8px; background: var(--accent3); border-radius: 50%; animation: pulse 1.5s infinite; }

  @keyframes pulse {
    0%,100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.7); }
  }

  .header-meta {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 1px;
  }

  .status-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(57,255,110,0.08);
    border: 1px solid rgba(57,255,110,0.2);
    border-radius: 20px;
    padding: 4px 12px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--accent3);
    letter-spacing: 1px;
  }
  .status-dot { width: 6px; height: 6px; background: var(--accent3); border-radius: 50%; animation: pulse 1.2s infinite; }

  /* ──── LAYOUT ──── */
  .layout {
    position: relative;
    z-index: 1;
    max-width: 1600px;
    margin: 0 auto;
    padding: 24px 32px 48px;
    display: grid;
    grid-template-columns: 340px 1fr;
    grid-template-rows: auto auto auto;
    gap: 20px;
  }

  /* ──── SCANNER PANEL ──── */
  .scanner-panel {
    grid-row: 1 / 4;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .panel-header {
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .panel-title {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--accent);
    text-transform: uppercase;
  }

  .panel-icon { font-size: 16px; }

  /* RFID visual */
  .rfid-visual {
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .rfid-chip {
    width: 120px;
    height: 80px;
    border: 2px solid var(--accent);
    border-radius: 8px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,229,255,0.04);
    transition: all 0.3s;
  }

  .rfid-chip.scanning {
    border-color: var(--accent3);
    background: rgba(57,255,110,0.08);
    box-shadow: 0 0 20px rgba(57,255,110,0.3);
  }

  .rfid-chip::before, .rfid-chip::after {
    content: '';
    position: absolute;
    border: 1px solid;
    border-radius: 50%;
    animation: rfid-wave 2s infinite;
    opacity: 0;
  }
  .rfid-chip::before { width: 140px; height: 100px; border-color: rgba(0,229,255,0.3); animation-delay: 0s; }
  .rfid-chip::after  { width: 165px; height: 120px; border-color: rgba(0,229,255,0.15); animation-delay: 0.5s; }

  @keyframes rfid-wave {
    0% { opacity: 0.8; transform: scale(0.8); }
    100% { opacity: 0; transform: scale(1.2); }
  }

  .rfid-inner {
    font-family: var(--mono);
    font-size: 9px;
    color: var(--accent);
    letter-spacing: 1px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    align-items: center;
  }

  .rfid-lines {
    display: flex;
    gap: 3px;
  }
  .rfid-line {
    width: 2px;
    height: 20px;
    background: var(--accent);
    opacity: 0.6;
  }
  .rfid-line:nth-child(2) { height: 28px; }
  .rfid-line:nth-child(4) { height: 14px; }
  .rfid-line:nth-child(5) { height: 24px; }
  .rfid-line:nth-child(6) { height: 18px; }

  .scan-id {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--accent);
    letter-spacing: 2px;
    opacity: 0.7;
  }

  /* Controls */
  .controls {
    padding: 0 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .field-label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  select, input {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-family: var(--mono);
    font-size: 12px;
    padding: 10px 12px;
    outline: none;
    transition: border-color 0.2s;
    appearance: none;
  }
  select:focus, input:focus { border-color: var(--accent); }

  .action-toggle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .toggle-btn {
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 1px;
  }
  .toggle-btn.active-in {
    background: rgba(57,255,110,0.1);
    border-color: var(--accent3);
    color: var(--accent3);
  }
  .toggle-btn.active-out {
    background: rgba(255,107,53,0.1);
    border-color: var(--accent2);
    color: var(--accent2);
  }

  .qty-field {
    display: flex;
    gap: 8px;
  }
  .qty-field input { width: 80px; flex-shrink: 0; text-align: center; }

  .scan-btn {
    width: 100%;
    padding: 14px;
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
  }
  .scan-btn:hover { background: #33ecff; transform: translateY(-1px); box-shadow: 0 4px 20px rgba(0,229,255,0.3); }
  .scan-btn:active { transform: translateY(0); }

  .scan-btn.scanning-anim {
    background: var(--accent3);
    animation: scan-flash 0.4s ease;
  }

  @keyframes scan-flash {
    0% { box-shadow: 0 0 0px rgba(57,255,110,0); }
    50% { box-shadow: 0 0 30px rgba(57,255,110,0.6); }
    100% { box-shadow: 0 0 0px rgba(57,255,110,0); }
  }

  .last-scan-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted);
    min-height: 60px;
  }
  .last-scan-box .scan-result {
    color: var(--accent3);
    font-size: 11px;
    line-height: 1.7;
  }

  /* ──── KPI STRIP ──── */
  .kpi-strip {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .kpi-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 18px 20px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s;
  }
  .kpi-card::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--accent);
    opacity: 0.5;
  }
  .kpi-card.warn::after { background: var(--warn); opacity: 1; }
  .kpi-card.danger::after { background: var(--danger); opacity: 1; }
  .kpi-card.success::after { background: var(--accent3); opacity: 1; }

  .kpi-label {
    font-family: var(--mono);
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .kpi-value {
    font-family: var(--mono);
    font-size: 32px;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
    transition: all 0.3s;
  }
  .kpi-sub {
    font-size: 11px;
    color: var(--muted);
    margin-top: 4px;
  }

  /* ──── INVENTORY TABLE ──── */
  .inventory-panel {
    grid-column: 2;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .table-wrap { overflow-x: auto; }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  thead tr {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  th {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--muted);
    text-transform: uppercase;
    padding: 12px 16px;
    text-align: left;
    white-space: nowrap;
  }

  tbody tr {
    border-bottom: 1px solid rgba(30,45,61,0.5);
    transition: background 0.15s;
  }
  tbody tr:hover { background: rgba(0,229,255,0.03); }
  tbody tr.flash-row {
    animation: row-flash 0.6s ease;
  }

  @keyframes row-flash {
    0%   { background: rgba(57,255,110,0.15); }
    100% { background: transparent; }
  }

  td {
    padding: 13px 16px;
    font-size: 13px;
    vertical-align: middle;
  }

  .rfid-badge {
    font-family: var(--mono);
    font-size: 10px;
    background: rgba(0,229,255,0.08);
    border: 1px solid rgba(0,229,255,0.2);
    color: var(--accent);
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 1px;
  }

  .qty-cell {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 700;
    transition: color 0.3s;
  }

  .stock-bar-wrap {
    width: 80px;
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .stock-bar {
    height: 100%;
    border-radius: 2px;
    transition: width 0.4s, background 0.3s;
  }

  .status-badge {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 1px;
    padding: 3px 9px;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .status-ok     { background: rgba(57,255,110,0.08); color: var(--accent3); border: 1px solid rgba(57,255,110,0.2); }
  .status-low    { background: rgba(255,183,0,0.08);  color: var(--warn);    border: 1px solid rgba(255,183,0,0.2); }
  .status-critical { background: rgba(255,59,92,0.08); color: var(--danger); border: 1px solid rgba(255,59,92,0.2); }

  .loc-badge {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 2px 8px;
    border-radius: 4px;
  }

  /* ──── MOVEMENT LOG ──── */
  .movement-panel {
    grid-column: 2;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .log-list {
    max-height: 300px;
    overflow-y: auto;
    padding: 0;
  }

  .log-list::-webkit-scrollbar { width: 4px; }
  .log-list::-webkit-scrollbar-track { background: transparent; }
  .log-list::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

  .log-item {
    display: grid;
    grid-template-columns: 140px 100px 1fr 60px 60px 70px;
    gap: 12px;
    align-items: center;
    padding: 10px 16px;
    border-bottom: 1px solid rgba(30,45,61,0.4);
    font-size: 12px;
    animation: slide-in 0.3s ease;
  }

  @keyframes slide-in {
    from { opacity: 0; transform: translateX(-8px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .log-time {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted);
  }

  .log-action-in  { color: var(--accent3); font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: 1px; }
  .log-action-out { color: var(--accent2); font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: 1px; }

  .log-qty { font-family: var(--mono); font-size: 12px; color: var(--text); text-align: right; }
  .log-loc { font-family: var(--mono); font-size: 10px; color: var(--muted); }

  .log-empty {
    padding: 32px;
    text-align: center;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 1px;
  }

  /* ──── ALERTS PANEL ──── */
  .alerts-panel {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .alert-card {
    background: var(--panel);
    border-radius: 10px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    animation: slide-in 0.3s ease;
  }
  .alert-card.warn  { border: 1px solid rgba(255,183,0,0.3); background: rgba(255,183,0,0.04); }
  .alert-card.danger { border: 1px solid rgba(255,59,92,0.3); background: rgba(255,59,92,0.04); }

  .alert-icon { font-size: 18px; }
  .alert-content { flex: 1; }
  .alert-title { font-weight: 600; font-size: 13px; }
  .alert-sub { font-family: var(--mono); font-size: 10px; color: var(--muted); margin-top: 2px; letter-spacing: 1px; }

  .alert-qty {
    font-family: var(--mono);
    font-size: 20px;
    font-weight: 700;
  }
  .alert-qty.warn { color: var(--warn); }
  .alert-qty.danger { color: var(--danger); }

  .no-alerts {
    background: var(--panel);
    border: 1px solid rgba(57,255,110,0.2);
    border-radius: 10px;
    padding: 16px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--accent3);
  }

  /* ──── AUTO SCAN PANEL ──── */
  .auto-panel {
    padding: 0 20px 20px;
    border-top: 1px solid var(--border);
    padding-top: 16px;
    margin-top: auto;
  }

  .auto-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .auto-label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 1px;
  }

  .toggle-switch {
    position: relative;
    width: 40px;
    height: 22px;
  }
  .toggle-switch input { opacity: 0; width: 0; height: 0; }
  .slider {
    position: absolute;
    inset: 0;
    background: var(--border);
    border-radius: 22px;
    cursor: pointer;
    transition: 0.3s;
  }
  .slider::before {
    content: '';
    position: absolute;
    width: 16px; height: 16px;
    left: 3px; top: 3px;
    background: var(--muted);
    border-radius: 50%;
    transition: 0.3s;
  }
  input:checked + .slider { background: rgba(0,229,255,0.3); }
  input:checked + .slider::before { transform: translateX(18px); background: var(--accent); }

  /* ──── SECTION HEADERS ──── */
  .section-hdr {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
  }

  .badge-count {
    font-family: var(--mono);
    font-size: 10px;
    background: rgba(0,229,255,0.1);
    border: 1px solid rgba(0,229,255,0.2);
    color: var(--accent);
    padding: 2px 8px;
    border-radius: 4px;
  }

  /* ──── TOAST ──── */
  #toast {
    position: fixed;
    bottom: 32px;
    right: 32px;
    z-index: 999;
    background: var(--panel);
    border-radius: 8px;
    padding: 14px 18px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 1px;
    max-width: 280px;
    transform: translateY(80px);
    opacity: 0;
    transition: all 0.3s cubic-bezier(.175,.885,.32,1.275);
    pointer-events: none;
  }
  #toast.show {
    transform: translateY(0);
    opacity: 1;
  }
  #toast.in-toast  { border: 1px solid rgba(57,255,110,0.3); color: var(--accent3); }
  #toast.out-toast { border: 1px solid rgba(255,107,53,0.3); color: var(--accent2); }
  #toast.warn-toast { border: 1px solid rgba(255,183,0,0.4); color: var(--warn); }

  /* ──── RESPONSIVE ──── */
  @media (max-width: 1100px) {
    .layout { grid-template-columns: 1fr; }
    .scanner-panel { grid-row: auto; }
    .kpi-strip, .inventory-panel, .movement-panel, .alerts-panel { grid-column: 1; }
    .kpi-strip { grid-template-columns: repeat(2, 1fr); }
  }

  /* ──── AI PREDICTION PANEL ──── */
  .ai-panel {
    grid-column: 2;
    background: var(--panel);
    border: 1px solid rgba(167,139,250,0.25);
    border-radius: 12px;
    overflow: hidden;
  }
  .ai-panel-hdr {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(167,139,250,0.15);
    background: rgba(167,139,250,0.04);
  }
  .ai-title {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 2px;
    color: #a78bfa;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ai-dot {
    width: 7px; height: 7px;
    background: #a78bfa;
    border-radius: 50%;
    animation: pulse 1.8s infinite;
  }
  .ai-badge {
    font-family: var(--mono);
    font-size: 10px;
    background: rgba(167,139,250,0.1);
    border: 1px solid rgba(167,139,250,0.25);
    color: #a78bfa;
    padding: 2px 10px;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .ai-badge:hover { background: rgba(167,139,250,0.2); }

  .ai-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-bottom: 1px solid rgba(167,139,250,0.1);
    flex-wrap: wrap;
  }
  .ai-select {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-family: var(--mono);
    font-size: 11px;
    padding: 7px 12px;
    outline: none;
    flex: 1;
    min-width: 180px;
    appearance: none;
  }
  .ai-select:focus { border-color: #a78bfa; }
  .ai-run-btn {
    background: linear-gradient(135deg,#a78bfa,#7c3aed);
    color: #fff;
    border: none;
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 8px 18px;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.15s;
    white-space: nowrap;
  }
  .ai-run-btn:hover { opacity: 0.88; transform: translateY(-1px); }
  .ai-run-all-btn {
    background: rgba(167,139,250,0.12);
    color: #a78bfa;
    border: 1px solid rgba(167,139,250,0.3);
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 8px 14px;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .ai-run-all-btn:hover { background: rgba(167,139,250,0.22); }

  .ai-body { padding: 18px 20px; }

  /* summary cards row */
  .ai-summary-row {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 12px;
